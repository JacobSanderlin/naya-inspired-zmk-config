#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Your Custom Primary Alpha Layout
        default_layer {
            bindings = <
// ---------------------------------------------------------------------------------------------------------------------------------
// | ESC   |  ~   |  1  |  2  |  3  |  4  |  5  | ENTER |   | BACK  |  6  |  7  |  8  |  9  |  0  |  -   |  +   |
// | TAB   |  -   |  Q  |  W  |  E  |  R  |  T  |       |   |       |  Y  |  U  |  I  |  O  |  P  |  {   |  }   |
// | CAPS  |  -   |  A  |  S  |  D  |  F  |  G  |       |   |       |  H  |  J  |  K  |  L  |  ;  |  "   |  /   |
// | SHIFT |  -   |  Z  |  X  |  C  |  V  |  B  |       |   |       |  N  |  M  |  ,  |  .  |  ?  | SHIFT|  -   |
// | LAYER | CTRL | WIN | ALT | SPACE       |  -  | ||  | - |   | - | ||  | - |       | SPACE| ALT | WIN  | CTRL | LAYER |
// ---------------------------------------------------------------------------------------------------------------------------------
    &kp ESC   &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp RET       &kp BSPC  &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL
    &kp TAB   &none     &kp Q     &kp W     &kp E     &kp R     &kp T                             &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT
    &kp CLCK  &none     &kp A     &kp S     &kp D     &kp F     &kp G                             &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp FSLH
    &kp LSHFT &none     &kp Z     &kp X     &kp C     &kp V     &kp B                             &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &none
    &mo 1     &kp LCTRL &kp LGUI  &kp LALT  &kp SPACE &none     &none     &none         &none     &none     &none     &kp SPACE &kp RALT  &kp RGUI  &kp RCTRL &mo 1
            >;
        };

        // Layer 1: Hardware Management & Wireless Selection
        system_layer {
            bindings = <
    &none     &none     &none        &none        &none        &none        &none     &none         &none     &none     &none        &none        &none        &none     &none     &none
    &none     &none     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none                             &none     &none        &none        &none        &none     &none     &none
    &none     &none     &none        &none        &none        &none        &none                             &none     &none        &none        &none        &none     &none     &none
    &none     &none     &none        &none        &bt BT_CLR   &none        &none                             &none     &none        &none        &none        &none     &none     &none
    &trans    &none     &none        &none        &none        &none        &none     &none         &none     &none     &none        &none        &none        &none     &none     &trans
            >;
        };
    };
};
