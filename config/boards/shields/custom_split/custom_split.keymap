#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: bindings are positional — they match the matrix transform
        // 1:1, left-to-right, top-to-bottom (8,7,7,7,8 keys per half per row).
        default_layer {
            bindings = <
    &kp ESC   &kp GRAVE &kp N1 &kp N2 &kp N3   &kp N4 &kp N5    &kp RET      &kp BSPC &kp N6    &kp N7  &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL
    &none   &kp TAB     &kp Q  &kp W  &kp E    &kp R  &kp T                &kp Y  &kp U     &kp I   &kp O   &kp P  &kp LBKT  &kp RBKT
    &none  &kp CAPS  &kp A  &kp S  &kp D    &kp F  &kp G                &kp H  &kp J     &kp K   &kp L   &kp SEMI  &kp SQT   &kp BSLH
    &none &kp SHIFT     &kp Z  &kp X  &kp C    &kp V  &kp B                &kp N  &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &none
    &mo 1     &kp LCTRL &kp LGUI &kp LALT &kp SPACE &none &kp BSPC &mo 2   &mo 2 &kp RET &none &kp SPACE &kp RALT &kp RGUI &kp RCTRL &mo 1
            >;
        };

        // Layer 1: Hardware Management & Wireless Selection
        system_layer {
            bindings = <
    &trans &trans &trans      &trans      &trans      &trans      &trans &trans      &trans &trans &trans &trans &trans &trans &trans &trans
    &trans &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &trans            &trans &trans &trans &trans &trans &trans &trans
    &trans &trans &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans            &trans &trans &trans &trans &trans &trans &trans
    &trans &trans &trans      &trans      &bt BT_CLR  &trans      &trans            &trans &trans &trans &trans &trans &trans &trans
    &trans &trans &trans      &trans      &trans      &trans      &trans &trans      &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        // Layer 2: example Numbers/Symbols layer — bind a key to &mo 2 (or &lt 2 <KEYCODE>) on another layer to reach it.
        num_layer {
            bindings = <
    &trans &trans &trans   &trans   &trans   &trans   &trans          &trans   &trans   &trans   &trans  &trans  &trans &trans &trans &trans
    &trans &trans &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                   &kp N6   &kp N7   &kp N8  &kp N9  &kp N0 &trans &trans
    &trans &trans &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT                &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &trans &trans
    &trans &trans &trans   &trans   &trans   &trans   &trans                   &trans   &trans   &trans  &trans  &trans &trans &trans
    &trans &trans &trans   &trans   &trans   &trans   &trans   &trans          &trans   &trans   &trans  &trans  &trans &trans &trans &trans
            >;
        };
    };
};

